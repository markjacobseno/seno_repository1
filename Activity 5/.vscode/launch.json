    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open Landingpage in Edge",
            "request": "launch",
            "type": "pwa-msedge",
            "url": "file:///${workspaceFolder}/Landingpage.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open Blogs in Edge",
            "request": "launch",
            "type": "pwa-msedge",
            "url": "file:///${workspaceFolder}/Blogs.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open Services in Edge",
            "request": "launch",
            "type": "pwa-msedge",
            "url": "file:///${workspaceFolder}/services.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open Home in Edge",
            "request": "launch",
            "type": "pwa-msedge",
            "url": "file:///${workspaceFolder}/home.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}